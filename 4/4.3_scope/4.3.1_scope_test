1)
x = 10

def func():
    x = 20
    print(x)

func()
print(x)


2)
x = 10

def func():
    print(x)

func()


3)
def outer():
    y = 5
    def inner():
        print(y)
    inner()

outer()


4)
def func():
    a = 1
    b = 2
    print(locals())

func()


1. 20 -> 10
2. 10
3. 5
4. {a: 1, b: 2}